generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String?
  profilePicture String?         @map("profile_picture")
  referralCode   String          @unique @map("referral_code")
  referredById   String?         @map("referred_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  coupons        Coupon[]
  referredBy     Customer?       @relation("Referral", fields: [referredById], references: [id])
  referrals      Customer[]      @relation("Referral")
  pointRecords   PointRecord[]
  reviews        Review[]
  transactions   Transaction[]

  @@map("customers")
}

model Organizer {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  password       String
  profilePicture String?       @map("profile_picture")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  role           OrganizerRole @default(ADMIN)
  events         Event[]

  @@map("organizers")
}

model PointRecord {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  amount      Decimal   @db.Decimal(65, 2)
  expiresAt   DateTime  @map("expires_at")
  isUsed      Boolean   @default(false) @map("is_used")
  createdAt   DateTime  @default(now()) @map("created_at")
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@map("point_records")
}

model Coupon {
  id             String       @id @default(uuid())
  customerId     String       @map("customer_id")
  discountAmount Decimal      @map("discount_amount") @db.Decimal(65, 2)
  expiresAt      DateTime     @map("expires_at")
  isUsed         Boolean      @default(false) @map("is_used")
  createdAt      DateTime     @default(now()) @map("created_at")
  customer       Customer     @relation(fields: [customerId], references: [id])
  transaction    Transaction?

  @@map("coupons")
}

model Event {
  id             String        @id @default(uuid())
  organizerId    String        @map("organizer_id")
  name           String
  description    String
  category       String
  location       String
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  availableSeats Int           @map("available_seats")
  isFree         Boolean       @default(false) @map("is_free")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organizer      Organizer     @relation(fields: [organizerId], references: [id])
  reviews        Review[]
  ticketTypes    TicketType[]
  transactions   Transaction[]
  vouchers       Voucher[]

  @@map("events")
}

model TicketType {
  id           String        @id @default(uuid())
  eventId      String        @map("event_id")
  name         String
  price        Decimal       @db.Decimal(65, 2)
  event        Event         @relation(fields: [eventId], references: [id])
  transactions Transaction[]

  @@map("ticket_types")
}

model Voucher {
  id             String        @id @default(uuid())
  eventId        String        @map("event_id")
  code           String
  discountAmount Decimal       @map("discount_amount") @db.Decimal(65, 2)
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  transactions   Transaction[]
  event          Event         @relation(fields: [eventId], references: [id])

  @@map("vouchers")
}

model Transaction {
  id                   String            @id @default(uuid())
  customerId           String            @map("customer_id")
  eventId              String            @map("event_id")
  ticketTypeId         String            @map("ticket_type_id")
  quantity             Int
  pointsUsed           Decimal           @default(0) @map("points_used") @db.Decimal(65, 2)
  voucherId            String?           @map("voucher_id")
  couponId             String?           @unique @map("coupon_id")
  totalPrice           Decimal           @map("total_price") @db.Decimal(65, 2)
  status               TransactionStatus
  statusUpdatedBy      StatusUpdater?    @map("status_updated_by")
  paymentProofUrl      String?           @map("payment_proof_url")
  proofUploadedAt      DateTime?         @map("proof_uploaded_at")
  expiresAt            DateTime          @map("expires_at")
  confirmationDeadline DateTime?         @map("confirmation_deadline")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  customer             Customer          @relation(fields: [customerId], references: [id])
  coupon               Coupon?           @relation(fields: [couponId], references: [id])
  event                Event             @relation(fields: [eventId], references: [id])
  ticketType           TicketType        @relation(fields: [ticketTypeId], references: [id])
  voucher              Voucher?          @relation(fields: [voucherId], references: [id])

  @@map("transactions")
}

model Review {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  eventId    String   @map("event_id")
  rating     Int
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id])

  @@map("reviews")
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum StatusUpdater {
  SYSTEM
  ORGANIZER
  CUSTOMER
}

enum OrganizerRole {
  ADMIN
  SUPER_ADMIN
}